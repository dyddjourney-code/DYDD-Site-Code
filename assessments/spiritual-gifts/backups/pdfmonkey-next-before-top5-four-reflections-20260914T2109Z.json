ass=\"stew\"\u003eSteward\u003c/span\u003e' %}\n                {% if x != '' %}\u003cli\u003e{{ x }}\u003c/li\u003e{% endif %}\n              {% endfor %}\n            \u003c/ul\u003e\n          \u003c/td\u003e\n        \u003c/tr\u003e\n\n        {% assign lines = Top3_Correlation | newline_to_br | split: '\u003cbr /\u003e' %}\n        \u003ctr\u003e\n          \u003ctd\u003e\u003cb\u003e{{ Top3_Name }}\u003c/b\u003e\u003c/td\u003e\n          \u003ctd\u003e{{ Top3_Definition }}\u003c/td\u003e\n          \u003ctd\u003e{{ Top3_Scripture }}\u003c/td\u003e\n          \u003ctd\u003e{{ Top3_Blurb }}\u003c/td\u003e\n          \u003ctd\u003e\n            \u003cul class=\"corr\"\u003e\n              {% for line in lines %}\n                {% assign x = line\n                  | replace: 'Architect', '\u003cspan class=\"arch\"\u003eArchitect\u003c/span\u003e'\n                  | replace: 'Artisan',  '\u003cspan class=\"arti\"\u003eArtisan\u003c/span\u003e'\n                  | replace: 'Shepherd', '\u003cspan class=\"shep\"\u003eShepherd\u003c/span\u003e'\n                  | replace: 'Steward',  '\u003cspan class=\"stew\"\u003eSteward\u003c/span\u003e' %}\n                {% if x != '' %}\u003cli\u003e{{ x }}\u003c/li\u003e{% endif %}\n              {% endfor %}\n            \u003c/ul\u003e\n          \u003c/td\u003e\n        \u003c/tr\u003e\n\n      \u003c/tbody\u003e\n    \u003c/table\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"page-break\"\u003e\u003c/div\u003e\n\n  \u003cdiv class=\"card\"\u003e\n    \u003ch2\u003eTop 5 Gift Summary (continued)\u003c/h2\u003e\n\n    \u003ctable class=\"table\"\u003e\n      \u003cthead\u003e\n        \u003ctr\u003e\n          \u003cth style=\"width: 12%;\"\u003eGift\u003c/th\u003e\n          \u003cth style=\"width: 20%;\"\u003eDefinition\u003c/th\u003e\n          \u003cth style=\"width: 16%;\"\u003eScripture\u003c/th\u003e\n          \u003cth style=\"width: 18%;\"\u003eHow it shows up\u003c/th\u003e\n          \u003cth style=\"width: 34%;\"\u003eDesignID reflection correlations\u003c/th\u003e\n        \u003c/tr\u003e\n      \u003c/thead\u003e\n      \u003ctbody\u003e\n\n        {% assign lines = Top4_Correlation | newline_to_br | split: '\u003cbr /\u003e' %}\n        \u003ctr\u003e\n          \u003ctd\u003e\u003cb\u003e{{ Top4_Name }}\u003c/b\u003e\u003c/td\u003e\n          \u003ctd\u003e{{ Top4_Definition }}\u003c/td\u003e\n          \u003ctd\u003e{{ Top4_Scripture }}\u003c/td\u003e\n          \u003ctd\u003e{{ Top4_Blurb }}\u003c/td\u003e\n          \u003ctd\u003e\n            \u003cul class=\"corr\"\u003e\n              {% for line in lines %}\n                {% assign x = line\n                  | replace: 'Architect', '\u003cspan class=\"arch\"\u003eArchitect\u003c/span\u003e'\n                  | replace: 'Artisan',  '\u003cspan class=\"arti\"\u003eArtisan\u003c/span\u003e'\n                  | replace: 'Shepherd', '\u003cspan class=\"shep\"\u003eShepherd\u003c/span\u003e'\n                  | replace: 'Steward',  '\u003cspan class=\"stew\"\u003eSteward\u003c/span\u003e' %}\n                {% if x != '' %}\u003cli\u003e{{ x }}\u003c/li\u003e{% endif %}\n              {% endfor %}\n            \u003c/ul\u003e\n          \u003c/td\u003e\n        \u003c/tr\u003e\n\n        {% assign lines = Top5_Correlation | newline_to_br | split: '\u003cbr /\u003e' %}\n        \u003ctr\u003e\n          \u003ctd\u003e\u003cb\u003e{{ Top5_Name }}\u003c/b\u003e\u003c/td\u003e\n          \u003ctd\u003e{{ Top5_Definition }}\u003c/td\u003e\n          \u003ctd\u003e{{ Top5_Scripture }}\u003c/td\u003e\n          \u003ctd\u003e{{ Top5_Blurb }}\u003c/td\u003e\n          \u003ctd\u003e\n            \u003cul class=\"corr\"\u003e\n              {% for line in lines %}\n                {% assign x = line\n                  | replace: 'Architect', '\u003cspan class=\"arch\"\u003eArchitect\u003c/span\u003e'\n                  | replace: 'Artisan',  '\u003cspan class=\"arti\"\u003eArtisan\u003c/span\u003e'\n                  | replace: 'Shepherd', '\u003cspan class=\"shep\"\u003eShepherd\u003c/span\u003e'\n                  | replace: 'Steward',  '\u003cspan class=\"stew\"\u003eSteward\u003c/span\u003e' %}\n                {% if x != '' %}\u003cli\u003e{{ x }}\u003c/li\u003e{% endif %}\n              {% endfor %}\n            \u003c/ul\u003e\n          \u003c/td\u003e\n        \u003c/tr\u003e\n\n      \u003c/tbody\u003e\n    \u003c/table\u003e\n  \u003c/div\u003e\n\n  \u003c!-- PAGE 4: Deep dives start cleanly --\u003e\n  \u003cdiv class=\"page-break\"\u003e\u003c/div\u003e\n\n  \u003cdiv class=\"card deepDiveCompact\"\u003e\n    \u003ch2\u003eTop 3 Spiritual Gifts Deep Dive\u003c/h2\u003e\n    \u003cp\u003e\n      These three gifts are the first places to look for repeated grace, service fruit, and confirmation from trusted people.\n    \u003c/p\u003e\n    \u003cdiv class=\"top-note\"\u003e\n      \u003cp\u003e{{ Tie_Note | default: \"If multiple gifts scored closely together, treat this ranking as a focused starting point rather than a final label.\" }}\u003c/p\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class=\"deepDiveItem\"\u003e\n      \u003cdiv class=\"deepDiveTitle\"\u003e\u003cspan\u003e1\u003c/span\u003e\u003ch3\u003e{{ Top1_Name }}\u003c/h3\u003e\u003c/div\u003e\n      \u003cp class=\"deepDiveScripture\"\u003e\u003cb\u003eAnchor Scripture:\u003c/b\u003e {{ Top1_AnchorScripture }}\u003c/p\u003e\n      \u003cdiv class=\"deepGrid\"\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eMaturity Overview\u003c/h4\u003e\n          \u003cp\u003e{{ Top1_MaturityDescription }}\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eGrowth Areas\u003c/h4\u003e\n          \u003cp\u003e{{ Top1_GrowthAreas }}\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eSigns of Immaturity\u003c/h4\u003e\n          \u003cp\u003e{{ Top1_SignsOfImmaturity }}\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eSteps to Grow\u003c/h4\u003e\n          \u003cp\u003e{{ Top1_StepsToGrow }}\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class=\"deepDiveItem\"\u003e\n      \u003cdiv class=\"deepDiveTitle\"\u003e\u003cspan\u003e2\u003c/span\u003e\u003ch3\u003e{{ Top2_Name }}\u003c/h3\u003e\u003c/div\u003e\n      \u003cp class=\"deepDiveScripture\"\u003e\u003cb\u003eAnchor Scripture:\u003c/b\u003e {{ Top2_AnchorScripture }}\u003c/p\u003e\n      \u003cdiv class=\"deepGrid\"\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eMaturity Overview\u003c/h4\u003e\n          \u003cp\u003e{{ Top2_MaturityDescription }}\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eGrowth Areas\u003c/h4\u003e\n          \u003cp\u003e{{ Top2_GrowthAreas }}\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eSigns of Immaturity\u003c/h4\u003e\n          \u003cp\u003e{{ Top2_SignsOfImmaturity }}\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eSteps to Grow\u003c/h4\u003e\n          \u003cp\u003e{{ Top2_StepsToGrow }}\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class=\"deepDiveItem\"\u003e\n      \u003cdiv class=\"deepDiveTitle\"\u003e\u003cspan\u003e3\u003c/span\u003e\u003ch3\u003e{{ Top3_Name }}\u003c/h3\u003e\u003c/div\u003e\n      \u003cp class=\"deepDiveScripture\"\u003e\u003cb\u003eAnchor Scripture:\u003c/b\u003e {{ Top3_AnchorScripture }}\u003c/p\u003e\n      \u003cdiv class=\"deepGrid\"\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eMaturity Overview\u003c/h4\u003e\n          \u003cp\u003e{{ Top3_MaturityDescription }}\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eGrowth Areas\u003c/h4\u003e\n          \u003cp\u003e{{ Top3_GrowthAreas }}\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eSigns of Immaturity\u003c/h4\u003e\n          \u003cp\u003e{{ Top3_SignsOfImmaturity }}\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch4\u003eSteps to Grow\u003c/h4\u003e\n          \u003cp\u003e{{ Top3_StepsToGrow }}\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003c!-- DYDD EXPLAINER PAGE --\u003e\n  \u003cdiv class=\"page-break\"\u003e\u003c/div\u003e\n\n  \u003cdiv class=\"card\"\u003e\n    \u003ch2 class=\"dydd-green\"\u003eWhat is Discover Your Divine Design\u003c/h2\u003e\n\n    \u003cp class=\"dydd-callout\"\u003eOn Purpose \u003cspan class=\"dydd-green\"\u003e-\u003c/span\u003e For Purpose\u003c/p\u003e\n\n    \u003cdiv class=\"dydd-flex\"\u003e\n      \u003cdiv\u003e\n        \u003cp\u003e\n          DYDD is a journey that helps you recognize how God has uniquely shaped your life for His purpose. By exploring\n          your identity, expertise, story, desires, gifts, and niche, you begin to see the intentional way God has designed\n          you to love, serve, and make a difference in the Body of Christ and beyond.\n        \u003c/p\u003e\n\n        \u003cp\u003e\n          At the heart of this journey is the belief that you were created \u003cspan class=\"dydd-highlight\"\u003eOn Purpose - For Purpose\u003c/span\u003e.\n          Your life is not random, and your design is not accidental. God has formed you with intention, redeemed your story\n          through Christ, and prepared good works for you to walk in faithfully.\n        \u003c/p\u003e\n\n        \u003cp\u003e\n          Discovering Your Divine Design is not about striving, performing, or trying to impress God. It is about responding\n          to His grace and living more fully as the person He created you to be. As you understand your DESIGN more clearly,\n          you can serve with greater confidence, humility, and joy.\n        \u003c/p\u003e\n\n        \u003cp class=\"small\" style=\"color:#111827;\"\u003e\n          “For we are God’s workmanship, created in Christ Jesus to do good works, which God prepared in advance for us to do.”\n          (Ephesians 2:10)\n        \u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003cdiv\u003e\n        \u003cimg class=\"dydd-image\"\n             src=\"https://images.squarespace-cdn.com/content/v1/685da500fbad741e29c08c78/a3b5b69f-3667-406c-9ba8-e9ec7ccddae3/envato-labs-image-edit+%2861%29.png?format=2500w\"\n             alt=\"Discover Your Divine Design acronym visual\" /\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class=\"hr\"\u003e\u003c/div\u003e\n\n    \u003ch3\u003eWhat were the DesignID reflection correlations\u003c/h3\u003e\n    \u003cp\u003e\n      As part of the DYDD ecosystem, we have built an identity assessment designed to help you see how you reflect who God is\n      as part of His creation and how you can use your design to love and serve. In this report, you’ve been given clues for how\n      each gift can correlate with the four reflections. The DesignID assessment is a key aspect of the DYDD journey.\n    \u003c/p\u003e\n\n    \u003ch3\u003eWhat else do we offer\u003c/h3\u003e\n    \u003cp\u003e\n      We offer a variety of resources including this Spiritual Gifts Assessment, the DesignID Assessment, the Discover Your Divine Design\n      book and workbook, online classes, and more. Check out our resource gateway.\n    \u003c/p\u003e\n\n    \u003cdiv class=\"top-note\"\u003e\n      \u003cp\u003e\n        \u003cb\u003eYour Spiritual Gifts class is the next step.\u003c/b\u003e\n        Create or sign into your DYDD account with the same email address to explore how these gifts can be understood, matured, and used with humility and purpose.\n      \u003c/p\u003e\n    \u003c/div\u003e\n\n    \u003cp class=\"small\"\u003e\n      Resources: \u003cb\u003ediscoverdivine.design/resources\u003c/b\u003e\n    \u003c/p\u003e\n  \u003c/div\u003e\n\n  \u003cp class=\"small\" style=\"margin-top:14px;\"\u003e\n    Generated for {{ Full_Name }}\n  \u003c/p\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e\n","created_at":"2026-09-14T22:49:39.617+02:00","deleted_at":null,"edition_mode":"code","identifier":"Spiritual Gifts - HTML Report NEXT","output_type":"pdf","sample_data":"","scss_style":"","settings":{"height":500,"width":500,"footer":{"center":null,"content":null,"left":null,"right":null},"header":{"center":null,"content":null,"left":null,"right":null},"inject_javascript":false,"margin":{"bottom":0,"left":0,"right":0,"top":0},"orientation":"portrait","paper_format":"a4","paper_height":297,"paper_width":210,"transparent_background":false,"use_emojis":false,"use_forms":false,"use_paged":false},"settings_draft":{"height":500,"width":500,"footer":{"center":null,"content":null,"left":null,"right":null},"header":{"center":null,"content":null,"left":null,"right":null},"inject_javascript":false,"margin":{"bottom":0,"left":0,"right":0,"top":0},"orientation":"portrait","paper_format":"a4","paper_height":297,"paper_width":210,"transparent_background":false,"use_emojis":false,"use_forms":false,"use_paged":false},"pdf_engine_id":"c1931951-3a89-4066-9eb7-0adce6c9dcc8","pdf_engine_draft_id":"c1931951-3a89-4066-9eb7-0adce6c9dcc8","schema_specification_id":null,"schema_specification_draft_id":null,"template_folder_id":"33cbc43b-19fb-4f0b-94a2-8f8a08591dbd","ttl":86400,"updated_at":"2026-09-14T22:49:39.617+02:00","body_draft":"\u003c!doctype html\u003e\n\u003chtml\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"utf-8\" /\u003e\n  \u003ctitle\u003eSpiritual Gifts Assessment Report - Next\u003c/title\u003e\n\n  \u003cstyle\u003e\n    /* Give room for fixed footer */\n    @page { size: Letter; margin: 0.65in 0.65in 1.05in 0.65in; }\n    * { box-sizing: border-box; }\n    body { font-family: Arial, Helvetica, sans-serif; color: #1f2937; margin: 0; padding-bottom: 0.6in; }\n\n    h1 { font-size: 22px; margin: 0 0 8px; }\n 