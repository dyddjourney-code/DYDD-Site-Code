  border-radius: 8px;\n      margin-bottom: 8px;\n      font-size: 12px;\n      font-weight: 700;\n    }\n\n    /* Table */\n    .table { width: 100%; border-collapse: collapse; font-size: 10px; table-layout: fixed; }\n    .table th, .table td { border: 1px solid #e5e7eb; padding: 7px; vertical-align: top; word-wrap: break-word; }\n    .table th { background: #f9fafb; text-align: left; }\n\n    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n    .top-note {\n      background: #f7f7f3;\n      border: 1px solid #e5e7db;\n      border-left: 4px solid #D4A451;\n      border-radius: 8px;\n      padding: 9px 11px;\n      margin: 10px 0 12px;\n    }\n    .top-note p { margin-bottom: 0; }\n\n    /* Correlations bullets */\n    .corr { margin: 0; padding-left: 16px; }\n    .corr li { margin: 0 0 4px; }\n\n    /* Reflection highlight colors */\n    .arch { color: #D4A451; font-weight: 700; }   /* Architect */\n    .arti { color: #647C9B; font-weight: 700; }   /* Artisan */\n    .shep { color: #739D5E; font-weight: 700; }   /* Shepherd */\n    .stew { color: #5A496B; font-weight: 700; }   /* Steward */\n\n    /* Deep Dive styling */\n    .deepHeader {\n      background: #4A6239;\n      color: white;\n      padding: 8px 12px;\n      border-radius: 6px;\n      font-size: 16px;\n      font-weight: bold;\n      margin-bottom: 8px;\n    }\n    .deepDiveCompact { padding: 12px; }\n    .deepDiveItem {\n      border: 1px solid #e5e7eb;\n      border-left: 4px solid #4A6239;\n      border-radius: 8px;\n      padding: 10px;\n      margin: 0 0 10px;\n      break-inside: avoid;\n      page-break-inside: avoid;\n    }\n    .deepDiveItem:last-child { margin-bottom: 0; }\n    .deepDiveTitle {\n      align-items: center;\n      display: flex;\n      gap: 8px;\n      margin-bottom: 6px;\n    }\n    .deepDiveTitle span {\n      align-items: center;\n      background: #4A6239;\n      border-radius: 999px;\n      color: white;\n      display: inline-flex;\n      font-size: 10px;\n      font-weight: 700;\n      height: 22px;\n      justify-content: center;\n      width: 22px;\n    }\n    .deepDiveTitle h3 {\n      border-bottom: 0;\n      font-size: 13px;\n      margin: 0;\n      padding: 0;\n    }\n    .deepDiveScripture {\n      color: #4b5563;\n      font-size: 9.5px;\n      margin: 0 0 6px;\n    }\n    .deepGrid {\n      display: grid;\n      gap: 8px;\n      grid-template-columns: 1fr 1fr;\n    }\n    .deepGrid h4 {\n      color: #4A6239;\n      font-size: 10px;\n      margin: 0 0 3px;\n    }\n    .deepGrid p {\n      font-size: 9.3px;\n      line-height: 1.34;\n      margin: 0;\n    }\n\n    /* Final page DYDD section */\n    .dydd-green { color: #4A6239; }\n\n    .dydd-highlight {\n      color: #4A6239;\n      font-weight: 700;\n    }\n\n    .dydd-flex {\n      display: grid;\n      grid-template-columns: 1.25fr 0.75fr;\n      gap: 18px;\n      align-items: start;\n      margin-top: 10px;\n    }\n\n    .dydd-image {\n      width: 100%;\n      height: auto;\n      border-radius: 10px;\n      border: 1px solid #e5e7eb;\n    }\n\n    .dydd-callout {\n      margin: 0 0 10px;\n      font-size: 13px;\n      font-weight: 700;\n      color: #4A6239;\n    }\n\n    /* Footer */\n    .footer {\n      position: fixed;\n      bottom: 0.25in;\n      left: 0.65in;\n      right: 0.65in;\n      font-size: 9px;\n      color: #6b7280;\n      display: flex;\n      justify-content: space-between;\n      border-top: 1px solid #e5e7eb;\n      padding-top: 6px;\n      background: white;\n    }\n\n    /* Welcome scripture darker */\n    .welcome-verse { font-size: 11px; color: #111827; }\n  \u003c/style\u003e\n\u003c/head\u003e\n\n\u003cbody\u003e\n\n  \u003c!-- Fixed Footer --\u003e\n  \u003cdiv class=\"footer\"\u003e\n    \u003cdiv\u003eDiscover Your Divine Design • Spiritual Gifts Next Report Preview\u003c/div\u003e\n    \u003cdiv\u003e© 2026 All Rights Reserved\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003c!-- PAGE 1: COVER / WELCOME --\u003e\n  \u003cdiv class=\"card avoid-break\"\u003e\n    \u003cdiv class=\"headerRow\"\u003e\n      \u003cdiv\u003e\n        \u003ch1\u003eSpiritual Gifts Assessment Report\u003c/h1\u003e\n        \u003cdiv class=\"small muted\"\u003ePersonalized results, confirmation language, and next steps for growth and service.\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cimg class=\"logo\"\n           src=\"https://images.squarespace-cdn.com/content/v1/685da500fbad741e29c08c78/70bddac9-e9c5-40ef-8bf8-48aaa5b498f9/dydd-gifts-logo.png?format=2500w\"\n           alt=\"Discover Your Divine Design\" /\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class=\"kv\"\u003e\n      \u003cdiv class=\"k\"\u003eName\u003c/div\u003e\u003cdiv\u003e{{ Full_Name }}\u003c/div\u003e\n      \u003cdiv class=\"k\"\u003eEmail\u003c/div\u003e\u003cdiv\u003e{{ Email_Address }}\u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class=\"hr\"\u003e\u003c/div\u003e\n\n    \u003cp\u003e\u003cb\u003eWelcome to Your Spiritual Gifts Assessment Report\u003c/b\u003e\u003c/p\u003e\n    \u003cp\u003e\n      Thank you for taking the time to explore how God has uniquely equipped you to serve His Kingdom.\n      At Discover Your Divine Design, we offer this assessment completely free because we believe every believer\n      should have access to tools that help them understand who God created them to be. Your design is not accidental,\n      and your gifts have purpose, meaning, and eternal significance.\n    \u003c/p\u003e\n    \u003cp\u003e\n      Our prayer is that this report encourages you, helps clarify your calling, and helps you step confidently into\n      the good works God has prepared for you. May what you discover here deepen your love for Christ, strengthen your service\n      within the Body, and illuminate the path He has placed before you.\n    \u003c/p\u003e\n\n    \u003cp class=\"welcome-verse\"\u003e\n      “Now to each one the manifestation of the Spirit is given for the common good.” (1 Corinthians 12:7)\n    \u003c/p\u003e\n  \u003c/div\u003e\n\n  \u003c!-- PAGE 1: TOP 5 GIFT BLOCKS --\u003e\n  \u003cdiv class=\"card avoid-break\"\u003e\n    \u003ch2\u003eYour Top 5 Spiritual Gifts\u003c/h2\u003e\n\n    \u003cp\u003e\n      These five gifts emerged most consistently throughout your responses and represent the areas where your spiritual design may most naturally express itself.\n    \u003c/p\u003e\n    \u003cdiv class=\"top-note\"\u003e\n      \u003cp\u003e\n        \u003cb\u003e{{ Result_Note | default: \"Use these results as a prayerful starting point. Spiritual gifts are best confirmed through Scripture, faithful service, and trusted people who have seen your life in motion.\" }}\u003c/b\u003e\n      \u003c/p\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class=\"giftWrap\"\u003e\n      \u003cdiv class=\"giftRow\"\u003e1. {{ Top1_Name }}\u003c/div\u003e\n      \u003cdiv class=\"giftRow\"\u003e2. {{ Top2_Name }}\u003c/div\u003e\n      \u003cdiv class=\"giftRow\"\u003e3. {{ Top3_Name }}\u003c/div\u003e\n      \u003cdiv class=\"giftRow\"\u003e4. {{ Top4_Name }}\u003c/div\u003e\n      \u003cdiv class=\"giftRow\"\u003e5. {{ Top5_Name }}\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003c!-- PAGE 2 starts here --\u003e\n  \u003cdiv class=\"page-break\"\u003e\u003c/div\u003e\n\n  \u003c!-- PAGE 2: TOP 5 TABLE --\u003e\n  \u003cdiv class=\"card\"\u003e\n    \u003ch2\u003eTop 5 Gift Summary\u003c/h2\u003e\n\n    \u003ctable class=\"table\"\u003e\n      \u003cthead\u003e\n        \u003ctr\u003e\n          \u003cth style=\"width: 12%;\"\u003eGift\u003c/th\u003e\n          \u003cth style=\"width: 20%;\"\u003eDefinition\u003c/th\u003e\n          \u003cth style=\"width: 16%;\"\u003eScripture\u003c/th\u003e\n          \u003cth style=\"width: 18%;\"\u003eHow it shows up\u003c/th\u003e\n          \u003cth style=\"width: 34%;\"\u003eDesignID reflection correlations\u003c/th\u003e\n        \u003c/tr\u003e\n      \u003c/thead\u003e\n      \u003ctbody\u003e\n\n  